# Credentials — never commit
Keys.txt
credentials.json
service_account.json
token.json

# Build artifacts (regenerated by build.bat)
dist/
build/
__pycache__/
*.pyc
scribe.spec

# Local virtual environments
.venv-cloud/
.venv-pipeline/

# Diarization ONNX models -- downloaded on first run, not source (~35MB)
models/

# Runtime data / logs / backups
Tamlelan_Backups/
*.log

# Audio recordings — real meeting content, not source
*.wav

# User scratch/handoff space -- holds real meeting summaries and transcripts
# (named third parties). Previously protected only by convention, which meant a
# single `git add -A` could have published real meeting content. Never commit.
RECENT/

# Ad-hoc investigation/validation scripts -- exploratory tools with hardcoded
# local paths, not production source. May contain a fetched copy of the
# Gemini API key (gk.txt) when in use -- never commit.
_investigation_scripts/
